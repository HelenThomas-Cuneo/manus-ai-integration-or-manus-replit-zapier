# Manus.ai API configuration
MANUS_API_KEY=your_manus_api_key_here

# Optional: port the Flask app listens on (Replit sets this automatically)
PORT=5000

# WhatsApp Business Cloud API (Meta Graph API) configuration
# Required only if you plan to use the /whatsapp/webhook endpoint
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=a_shared_secret_you_choose_for_webhook_verification
