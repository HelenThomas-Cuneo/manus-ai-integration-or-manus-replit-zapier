# These are used by `zapier env` or local testing with zapier-platform-core.
# Do not commit a real .env file.

MANUS_API_KEY=your_manus_api_key_here

# WhatsApp Business Cloud API (Meta Graph API) - required only for the
# "Send WhatsApp Message" action and "New WhatsApp Message Received" trigger
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
